# A Little Better — optional Supabase configuration
#
# The app is fully local-first and works completely offline with NO
# values set here. These are only needed once the (not-yet-built)
# cross-device sync feature is turned on. See src/lib/supabaseClient.ts
# and src/lib/sync/ for how these are used.
#
# Copy this file to .env.local (which is gitignored) and fill in your
# own Supabase project's values from Project Settings → API.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
