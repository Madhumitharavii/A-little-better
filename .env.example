# A Little Better — optional Supabase configuration
#
# The app is fully local-first and works completely offline with NO
# values set here. They're only needed to turn on optional
# cross-device sync. See src/lib/supabaseClient.ts
# and src/lib/sync/ for how these are used.
#
# Copy this file to .env.local (which is gitignored) and fill in your
# own Supabase project's values from Project Settings → API Keys
# (use the public anon key — never the service_role key).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
